# PostgreSQL connection string.
# Matches the docker-compose.yml service below.
DATABASE_URL="postgresql://campuswash:campuswash@localhost:5432/campuswash?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Cloudinary (image uploads — car photos).
# Without these, the upload endpoint returns 503 and photo upload is disabled,
# but ordering still works (the car photo is optional).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
