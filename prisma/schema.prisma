// CampusWash — Prisma schema (Phase 1)
// Mobile car-wash service for university students.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  WORKER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  email     String?  @unique
  // Nullable so freshly-created accounts can be routed to onboarding
  // before a role is chosen.
  role      Role?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars         Car[]
  orders       Order[] @relation("StudentOrders")
  workerOrders Order[] @relation("WorkerOrders")
}

model Car {
  id          String   @id @default(cuid())
  userId      String
  plateNumber String
  model       String?
  color       String?
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model ParkingLot {
  id                String  @id @default(cuid())
  name              String
  universitySection String?
  isActive          Boolean @default(true)

  orders Order[]
}

model ServiceType {
  id              String   @id @default(cuid())
  nameAr          String
  nameEn          String
  price           Decimal  @db.Decimal(8, 3)
  durationMinutes Int
  description     String?
  isActive        Boolean  @default(true)

  orders Order[]
}

model Order {
  id            String      @id @default(cuid())
  studentId     String
  workerId      String?
  carId         String
  parkingLotId  String
  serviceTypeId String
  spotCode      String?
  carPhotoUrl   String?
  afterPhotoUrl String?
  notes         String?
  status        OrderStatus @default(PENDING)
  totalPrice    Decimal     @db.Decimal(8, 3)
  createdAt     DateTime    @default(now())
  acceptedAt    DateTime?
  completedAt   DateTime?

  student     User        @relation("StudentOrders", fields: [studentId], references: [id])
  worker      User?       @relation("WorkerOrders", fields: [workerId], references: [id])
  car         Car         @relation(fields: [carId], references: [id])
  parkingLot  ParkingLot  @relation(fields: [parkingLotId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@index([studentId])
  @@index([workerId])
  @@index([status])
}
